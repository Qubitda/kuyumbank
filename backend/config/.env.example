# Copy to .env and fill in local values. Never commit .env.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=kuyumbank
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Optional
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# SECURE_SSL_REDIRECT=False
# SECURE_HSTS_SECONDS=3600
# SECURE_PROXY_SSL_HEADER=False
# TRUSTED_PROXY_COUNT=0
# DRF_THROTTLE_ANON=60/min
# DRF_THROTTLE_USER=600/min
# DRF_THROTTLE_BUYER=300/min
# DRF_THROTTLE_SUPPLIER=300/min
# DRF_THROTTLE_OPS=600/min
# DRF_THROTTLE_LOGIN=10/min
# LOGIN_THROTTLE_RATE=10/min
# LOGIN_THROTTLE_USERNAME_RATE=20/min
# TRUSTED_PROXY_COUNT=0
# API_BASIC_AUTH_ENABLED=  # boş → DEBUG değeri; prod’da False
# DRF_THROTTLE_BASIC=5/min
# AUTH_TOKEN_TTL_SECONDS=604800
# PASSWORD_MIN_LENGTH=12
# SESSION_COOKIE_AGE=28800
# SESSION_IDLE_TIMEOUT=1800
# IDEMPOTENCY_TTL_SECONDS=86400
# IDEMPOTENCY_LOCK_WAIT_SECONDS=5
# CONN_MAX_AGE=60
# CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
# CACHE_LOCATION=kuyumbank-default
# Prod (!DEBUG): varsayılan DatabaseCache; LocMem yasak (ALLOW_LOCMEM_CACHE=1 bilinçli)
# CACHE_BACKEND=django.core.cache.backends.db.DatabaseCache
# CACHE_LOCATION=kuyumbank_cache  (+ python manage.py createcachetable)
# ALLOW_LOCMEM_CACHE=0
# ALLOW_FAKE_PROVIDERS=0
# PAYMENT_PROVIDER=fake
# CARRIER_PROVIDER=fake
# PAYMENT_FAKE_FORCE_FAIL=0
# CARRIER_FAKE_FORCE_FAIL=0
# MFA_ENFORCE_PLATFORM=0
# PASSWORD_RESET_BASE_URL=https://app.example.com
# PASSWORD_RESET_TIMEOUT=3600
# Soft-launch A: ALLOW_FAKE_PROVIDERS=1 + soft_launch_check --allow-fake
# Soft-launch prod-ish: MFA_ENFORCE_PLATFORM=1 + createcachetable (RUNBOOK §11d)

# CSRF_TRUSTED_ORIGINS=https://app.localhost
# Yerel Next (NX-FE, port 3000) — aynı-origin rewrite için:
# CSRF_TRUSTED_ORIGINS=http://localhost:3000
# SESSION_COOKIE_DOMAIN=
# CSRF_COOKIE_DOMAIN=
# CORS: B1 kapsamı dışı (aynı-origin reverse proxy)
# LOG_LEVEL=INFO
# LOG_JSON=False
# SENTRY_DSN=   # F8-003: staging/prod DSN; boşsa SDK no-op
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.0
# PLATFORM_BRAND_NAME=Kuyumbank
# VARYANT_GRAM_BANDI_ORAN=0.05
# QC_GRAM_TOLERANCE_PCT=0.50
# QC_GRAM_TOLERANCE_ABS=0
# CARRIER_PROVIDER=fake
# CARRIER_FAKE_FORCE_FAIL=0
# SHIPMENT_POD_REQUIRED=0
# PAYMENT_WEBHOOK_SECRET=
# PAYMENT_WEBHOOK_REQUIRE_HMAC=1
# PAYMENT_WEBHOOK_REPLAY_SECONDS=300
# PAYMENT_WEBHOOK_IP_ALLOWLIST=
# DRF_THROTTLE_WEBHOOK=120/min

# Prod: Token TTL + purge_expired_tokens; Basic kapalı; TRUSTED_PROXY_COUNT ayarla
# (bkz. docs/RUNBOOK.md §6–§10 secret / deploy). MFA: PLANLANDI (platform/act-as).
